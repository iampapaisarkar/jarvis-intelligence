# Network — LAN only. Do not port-forward this service.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765
JARVIS_AUTH_TOKEN=change-me

# Local GGUF (relative to the repo root, or an absolute path)
LLM_MODEL_PATH=models/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_CHAT_FORMAT=chatml
LLM_N_CTX=2048
LLM_N_THREADS=
LLM_N_GPU_LAYERS=0
LLM_N_BATCH=256
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7
LLM_PRELOAD=false

# Later phases
STT_MODEL_PATH=models/stt/
TTS_MODEL_PATH=models/tts/

LOG_LEVEL=INFO
LOG_DIR=logs
