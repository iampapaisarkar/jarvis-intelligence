# Network — LAN only. Do not port-forward this service.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765
JARVIS_AUTH_TOKEN=change-me

# Local GGUF (relative to the repo root, or an absolute path)
LLM_MODEL_PATH=models/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_CHAT_FORMAT=chatml
LLM_N_CTX=2048
LLM_N_THREADS=
LLM_N_GPU_LAYERS=0
LLM_N_BATCH=256
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7
LLM_PRELOAD=false

# Local Whisper (relative path or a directory containing ggml-*.bin)
STT_MODEL_PATH=models/stt/ggml-base.bin
STT_LANGUAGE=auto
STT_N_THREADS=
STT_PRELOAD=false
STT_USE_GPU=false
STT_MAX_AUDIO_SECONDS=20

# Local Piper TTS (need both .onnx and .onnx.json)
TTS_MODEL_PATH=models/tts/en_US-ryan-medium.onnx
TTS_BN_MODEL_PATH=
TTS_PRELOAD=false
TTS_USE_CUDA=false
TTS_MAX_CHARS=500

# Intent parser (Phase 4). Tools are planned, never executed here.
JARVIS_DEFAULT_TARGET=windows
INTENT_MAX_TOKENS=192
INTENT_TEMPERATURE=0.1
INTENT_JSON_RETRIES=1

# Safety (Phase 5). Tools are still not executed.
SAFETY_CONFIRMATION_TTL_SECONDS=120

# Local tools (Phase 6+). Windows/posix run on the brain; Mac tools go over WebSocket.
JARVIS_TOOLS_ENABLED=true
JARVIS_TOOLS_BACKEND=auto
JARVIS_WORKSPACE=
JARVIS_TERMINAL_TIMEOUT_SECONDS=10
JARVIS_MAC_TIMEOUT_SECONDS=20

# Local SQLite memory (Phase 8). Secrets are never stored.
JARVIS_MEMORY_PATH=data/jarvis.sqlite
JARVIS_MEMORY_HISTORY_LIMIT=200
JARVIS_OWNER_NAME=
JARVIS_OWNER_EMAIL=
JARVIS_OWNER_PHONE=
JARVIS_OWNER_ADDRESS=
JARVIS_SPOUSE_NAME=
JARVIS_CHILD_NAME=

# Wake word (Phase 9). Detection is transcript-based, not a neural spotter.
JARVIS_WAKE_ENABLED=true
JARVIS_WAKE_WORD=jarvis

# LAN discovery so the Mac client can find the brain without typing an IP.
JARVIS_DISCOVERY_ENABLED=true
JARVIS_DISCOVERY_PORT=8766

LOG_LEVEL=INFO
LOG_DIR=logs
